# shellcheck shell=bash
# Bash completion for auto-reboot

_auto_reboot() {
  local cur prev opts
  COMPREPLY=()
  cur=${COMP_WORDS[COMP_CWORD]}
  prev=${COMP_WORDS[COMP_CWORD-1]}
  opts='-h --help -n --dry-run -N --not-dry-run -f --force-reboot -v --verbose -q --quiet
    -m --max-uptime-days -r --reboot-time -a --allowed-days -i --install
    -l --list -d --delete -D --delete-all -V --version'

  case $prev in
    -m|--max-uptime-days)
      mapfile -t COMPREPLY < <(compgen -W '1 3 7 14 30 60 90' -- "$cur")
      return 0 ;;
    -r|--reboot-time)
      mapfile -t COMPREPLY < <(compgen -W '00:00 01:00 02:00 03:00 04:00 22:00 23:00' -- "$cur")
      return 0 ;;
    -a|--allowed-days)
      local days='Sun Mon Tue Wed Thu Fri Sat
        Sunday Monday Tuesday Wednesday Thursday Friday Saturday 0 1 2 3 4 5 6'
      if [[ $cur == *,* ]]; then
        mapfile -t COMPREPLY < <(compgen -P "${cur%,*}," -W "$days" -- "${cur##*,}")
      else
        mapfile -t COMPREPLY < <(compgen -W "$days" -- "$cur")
      fi
      return 0 ;;
    -d|--delete)
      local timers
      timers=$(systemctl list-timers --all --no-pager 2>/dev/null \
        | grep -oE 'auto-reboot-[0-9]+\.timer' ||:)
      timers=${timers//.timer/}
      [[ -z $timers ]] || mapfile -t COMPREPLY < <(compgen -W "$timers ${timers//auto-reboot-/}" -- "$cur")
      return 0 ;;
  esac

  [[ $cur != -* ]] || mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
  return 0
}

complete -F _auto_reboot auto-reboot
