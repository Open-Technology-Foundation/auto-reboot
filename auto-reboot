#!/usr/bin/env bash
# auto-reboot - Schedule conditional system reboots via systemd timers
# Checks the reboot-required flag file and uptime threshold; dry-run by default
# Requires: systemd (systemd-run, systemctl)
set -euo pipefail
shopt -s inherit_errexit

# Lock PATH before the first external command runs
declare -rx PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

# Script metadata
declare -r VERSION=1.4.0
#shellcheck disable=SC2155 # BCS0103 metadata pattern; a failed realpath here is not recoverable
declare -r SCRIPT_PATH=$(realpath -- "$0")
declare -r SCRIPT_NAME=${SCRIPT_PATH##*/}

# Built-in defaults; CONF_FILE overrides them (read_conf), CLI options override both
declare -- MACHINE_REBOOT_TIME=22:00 MACHINE_UPTIME_MAXDAYS=14 MACHINE_ALLOWED_DAYS=''
declare -- PREFIX=${PREFIX:-/usr/local}
# Overridable so the test suite can stand in for the system files
declare -r REBOOT_REQUIRED_FILE=${REBOOT_REQUIRED_FILE:-/var/run/reboot-required}
declare -r CONF_FILE=${AUTO_REBOOT_CONF:-/etc/$SCRIPT_NAME.conf}

# Runtime state (frozen readonly after argument parsing)
declare -i REBOOT_NEEDED=0 DRY_RUN=1 FORCE_REBOOT=0 UPTIME_DAYS=0
declare -i VERBOSE=1
declare -a ALLOWED_DAYS=()  # Numeric days 0-6, 0=Sunday

# Audit trail: original invoking user
declare -r XUSER=${SUDO_USER:-${USER:-root}}

# Terminal colors
if [[ -t 1 && -t 2 ]]; then
  declare -r RED=$'\033[0;31m' YELLOW=$'\033[0;33m' CYAN=$'\033[0;36m' NC=$'\033[0m'
else
  declare -r RED='' YELLOW='' CYAN='' NC=''
fi

# Messaging (all output to stderr; stdout reserved for data)
# _msg dispatches icon/color based on caller function name via FUNCNAME[1]
_msg() {
  local -- prefix="$SCRIPT_NAME:" msg
  case ${FUNCNAME[1]} in
    info)  prefix+=" $CYAN◉$NC" ;;
    error) prefix+=" $RED✗$NC" ;;
    *) ;;
  esac
  for msg in "$@"; do printf '%s %s\n' "$prefix" "$msg"; done
}
error() { >&2 _msg "$@"; }
info() { ((VERBOSE)) || return 0; >&2 _msg "$@"; }
die() { (($# < 2)) || error "${@:2}"; exit "${1:-0}"; }

# Argument validation helper
noarg() { (($# > 1)) || die 22 "Option ${1@Q} requires an argument"; }

# Yes/no prompt on stderr; true only on y/Y
yn() {
  local -- REPLY
  >&2 printf '%s: %s▲%s %s y/n ' "$SCRIPT_NAME" "$YELLOW" "$NC" "${1:-Continue?}"
  read -r -n 1
  >&2 echo
  [[ ${REPLY,,} == y ]]
}

# Display help text
usage() {
  cat <<HELP
$SCRIPT_NAME $VERSION - Conditional system reboot scheduler

DESCRIPTION:
    Schedule conditional system reboots via systemd transient timers.
    Dry-run by default; use -N to execute.

    Reboot conditions (any one triggers scheduling):
      • System updates require reboot ($REBOOT_REQUIRED_FILE exists)
      • Uptime has reached the maximum threshold
      • Manual force reboot request (-f)

    Only one reboot is pending at a time: when an $SCRIPT_NAME timer already
    exists, a new run reports it and schedules nothing.

USAGE:
    $SCRIPT_NAME [OPTIONS]
    Designed for both interactive use and cron scheduling.

OPTIONS:
    -f, --force-reboot
                  Unconditional reboot. Ignore reboot-required and uptime.
    -n, --dry-run
                  Dry run only. Do not execute (default is dry run).
    -N, --not-dry-run
                  Execute (not a dry run)
    -v, --verbose Verbose output (default)
    -q, --quiet   Suppress informational messages
    -h, --help    Show this help message
    -i, --install Install a root-owned copy of $SCRIPT_NAME to $PREFIX/bin
                  (use 'make install' for the manpage and bash completion)
    -V, --version Show version information

    -m, --max-uptime-days DAYS
                  Maximum uptime in days before forced reboot (default: 14)
    -r, --reboot-time HH:MM
                  Time to schedule reboot in HH:MM format (default: 22:00)
    -a, --allowed-days DAYS
                  Restrict reboots to specific days of week
                  DAYS can be: Sun,Mon,Tue,Wed,Thu,Fri,Sat
                  Or: Sunday,Monday,Tuesday,Wednesday,Thursday,Friday,Saturday
                  Or: 0,1,2,3,4,5,6 (0=Sunday)
                  Multiple days: --allowed-days Sun,Mon,Fri

SCHEDULE MANAGEMENT:
    -l, --list    List all scheduled $SCRIPT_NAME timers
    -d, --delete TIMER
                  Delete a specific $SCRIPT_NAME timer immediately
                  TIMER can be: full name ($SCRIPT_NAME-1234.timer),
                  partial name ($SCRIPT_NAME-1234), or just ID (1234)
    -D, --delete-all
                  Delete all scheduled $SCRIPT_NAME timers
                  Dry run (default) only lists what would be deleted;
                  -N -D asks for confirmation, then deletes (-N before -D)

CONFIGURATION:
    $CONF_FILE
                  Site defaults, sourced as bash. Must be owned by root and
                  not group- or world-writable. No other path is searched.
                    MACHINE_REBOOT_TIME=22:00      overridden by --reboot-time
                    MACHINE_UPTIME_MAXDAYS=14      overridden by --max-uptime-days
                    MACHINE_ALLOWED_DAYS=          overridden by --allowed-days
    PREFIX        Installation prefix for --install (default: /usr/local)

EXIT STATUS:
    0  success                 13  not root/sudo group, or untrusted config file
    1  runtime failure         18  systemd-run not found
    2  unexpected argument     19  config file failed to load or has a bad value
                               22  invalid option or option value

EXAMPLES:
    $SCRIPT_NAME --dry-run
    $SCRIPT_NAME --max-uptime-days 14 --reboot-time 04:20 --allowed-days Sun -N
    $SCRIPT_NAME --allowed-days Mon,Wed,Fri --reboot-time 22:30 -N

CRON EXAMPLE:
    # Nightly check; reboot next Sunday 04:20 once uptime reaches 14 days
    15 23 * * * $SCRIPT_NAME -q --max-uptime-days 14 --reboot-time 04:20 --allowed-days Sun -N

HELP
  return 0
}

# HH:MM within 00:00-23:59 (a one-digit hour is accepted)
validate_time() {
  [[ $1 =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
  # 10# forces decimal: 08 and 09 are invalid octal literals
  (( 10#${BASH_REMATCH[1]} <= 23 && 10#${BASH_REMATCH[2]} <= 59 )) || return 1
  return 0
}

# Positive integer (leading zeros tolerated)
validate_days() {
  [[ $1 =~ ^[0-9]+$ ]] || return 1
  (( 10#$1 > 0 )) || return 1
  return 0
}

# Abort unless systemd-run is available (it ships with systemd itself)
systemd_run_required() {
  command -v systemd-run &>/dev/null \
    || die 18 'systemd-run not found; this host does not appear to run systemd'
}

# Parse day specification (Sun, Sunday, 0, etc.) to numeric day (0-6)
parse_day() {
  local -- day=$1
  case ${day,,} in
    sun|sunday|0) echo 0 ;;
    mon|monday|1) echo 1 ;;
    tue|tuesday|2) echo 2 ;;
    wed|wednesday|3) echo 3 ;;
    thu|thursday|4) echo 4 ;;
    fri|friday|5) echo 5 ;;
    sat|saturday|6) echo 6 ;;
    *) error "Invalid day ${day@Q}. Use Sun-Sat, Sunday-Saturday, or 0-6."
       return 1 ;;
  esac
}

# Parse comma-separated day list into ALLOWED_DAYS array
parse_allowed_days() {
  local -- day_list=$1
  local -- day parsed_day
  local -a days=()
  declare -g ALLOWED_DAYS=()

  IFS=',' read -ra days <<< "$day_list"
  for day in "${days[@]}"; do
    # Trim surrounding whitespace with builtins
    day=${day#"${day%%[![:space:]]*}"}
    day=${day%"${day##*[![:space:]]}"}
    parsed_day=$(parse_day "$day") || return 1
    ALLOWED_DAYS+=("$parsed_day")
  done
}

# Check if current day is in ALLOWED_DAYS array
is_reboot_day_allowed() {
  # No restrictions = any day allowed
  ((${#ALLOWED_DAYS[@]})) || return 0

  local -i current_day allowed_day
  # date(1) rather than printf '%(%w)T' so the test suite can mock the clock
  current_day=$(date +'%w')  # 0-6, 0=Sunday

  for allowed_day in "${ALLOWED_DAYS[@]}"; do
    (( current_day != allowed_day )) || return 0
  done
  return 1
}

# Set REBOOT_NEEDED and UPTIME_DAYS based on system state
check_reboot_conditions() {
  # Globals modified inside function scope
  declare -g UPTIME_DAYS REBOOT_NEEDED
  local -- boot_time
  local -i uptime_start current_time

  [[ ! -f $REBOOT_REQUIRED_FILE ]] || REBOOT_NEEDED=1

  boot_time=$(uptime -s) || die 1 'uptime -s failed; cannot determine boot time'
  uptime_start=$(date -d "$boot_time" +'%s') || die 1 "Cannot parse boot time ${boot_time@Q}"
  # date(1) rather than $EPOCHSECONDS so the test suite can mock the clock
  current_time=$(date +'%s')
  UPTIME_DAYS=$(( (current_time - uptime_start) / 86400 ))

  (( UPTIME_DAYS < MACHINE_UPTIME_MAXDAYS )) || REBOOT_NEEDED=1

  # --force-reboot overrides all conditions
  (( ! FORCE_REBOOT )) || REBOOT_NEEDED=1
}

# Print epoch seconds for "DAYSPEC HH:MM" (e.g. "today 22:00"); fails if date rejects it
epoch_at() { date -d "$1 $2" +'%s' 2>/dev/null; }

# Calculate seconds until next reboot window
# Args: target_time (HH:MM) — Stdout: delay in seconds
# Returns 1 on invalid input, date failure, or no valid day within 7 days
calculate_reboot_delay() {
  local -- target_time=$1 hm allowed_day
  local -i current_epoch target_epoch hour minute
  local -i days_ahead current_day check_day found=0

  [[ $target_time =~ ^([0-9]{1,2}):([0-9]{2})$ ]] \
    || { error "Invalid time format ${target_time@Q}. Use HH:MM format."; return 1; }
  # 10# forces decimal: 08 and 09 are invalid octal literals
  hour=$((10#${BASH_REMATCH[1]}))
  minute=$((10#${BASH_REMATCH[2]}))
  printf -v hm '%02d:%02d' "$hour" "$minute"
  # date(1) rather than $EPOCHSECONDS so the test suite can mock the clock
  current_epoch=$(date +'%s')

  if (( ${#ALLOWED_DAYS[@]} == 0 )); then
    target_epoch=$(epoch_at today "$hm") || { error "Cannot resolve time ${hm@Q}"; return 1; }
    if (( target_epoch <= current_epoch )); then
      target_epoch=$(epoch_at tomorrow "$hm") || { error "Cannot resolve time ${hm@Q}"; return 1; }
    fi
  else
    # date(1) rather than printf '%(%w)T' so the test suite can mock the clock
    current_day=$(date +'%w')

    # Try today first
    target_epoch=$(epoch_at today "$hm") || { error "Cannot resolve time ${hm@Q}"; return 1; }
    if (( target_epoch > current_epoch )) && is_reboot_day_allowed; then
      found=1
    fi

    # Search up to 7 days ahead for next allowed day
    if (( ! found )); then
      for ((days_ahead=1; days_ahead<=7; days_ahead+=1)); do
        check_day=$(( (current_day + days_ahead) % 7 ))
        for allowed_day in "${ALLOWED_DAYS[@]}"; do
          if (( check_day == allowed_day )); then
            target_epoch=$(epoch_at "+$days_ahead days" "$hm") \
              || { error "Cannot resolve time ${hm@Q}"; return 1; }
            found=1
            break 2
          fi
        done
      done
    fi

    (( found )) || { error 'No valid reboot day found in next 7 days'; return 1; }
  fi

  echo "$((target_epoch - current_epoch))"
}

# Print names of scheduled auto-reboot timers, one per line (nothing when none)
existing_timers() {
  # list-timers is more reliable than status for transient timers
  systemctl list-timers --all --no-pager 2>/dev/null | grep -oE "$SCRIPT_NAME-[0-9]+\.timer" ||:
}

# Schedule reboot via systemd-run transient timer
# Args: delay (seconds until reboot)
schedule_reboot() {
  local -i delay=$1
  local -- existing unit when

  systemd_run_required

  # Allow running (0) or degraded (1) systemd states
  local -i sys_rc=0
  systemctl is-system-running &>/dev/null || sys_rc=$?
  if (( sys_rc > 1 )); then
    error 'systemd is not running. This script requires systemd for reliable scheduling.'
    return 1
  fi

  # One pending reboot at a time; nightly cron runs must not stack timers
  existing=$(existing_timers | head -n 1)
  if [[ -n $existing ]]; then
    info "Reboot already scheduled by $existing; not scheduling another"
    return 0
  fi

  if (( DRY_RUN )); then
    info "systemd-run: [DRY RUN] Reboot scheduled in $delay seconds"
    return 0
  fi

  unit="$SCRIPT_NAME-$EPOCHSECONDS"
  printf -v when '%(%F %T)T' "$((EPOCHSECONDS + delay))"
  logger -t "$SCRIPT_NAME" "Scheduling system reboot in ${delay}s for user $XUSER (uptime: ${UPTIME_DAYS}d)"
  # --quiet: without it systemd-run prints "Running timer as unit" to
  # stderr, which cron mails every night in the week before a reboot.
  # --on-calendar (an absolute wall-clock target) rather than --on-active (a
  # delay in seconds): the reboot slot IS a wall-clock time up to a week out,
  # so state it as one. systemd then exposes it as NextElapseUSecRealtime, so a
  # wrong target is visible on inspection instead of hidden behind "N seconds
  # from activation", and a clock correction between scheduling and firing
  # carries the timer with it rather than preserving a stale offset.
  systemd-run --quiet --on-calendar="$when" --timer-property=AccuracySec=1s \
      --unit="$unit" --description="Scheduled reboot by $SCRIPT_NAME" \
      /sbin/shutdown -r now "Scheduled reboot by $SCRIPT_NAME" \
    || { error 'systemd-run: Failed to schedule reboot'; return 1; }
  logger -t "$SCRIPT_NAME" "Successfully scheduled reboot for $when ($unit.timer)"
  info "systemd-run: Reboot scheduled in $delay seconds ($unit.timer)"
}

# List all scheduled auto-reboot timers
list_schedules() {
  local -a timers=()
  local -- timer next
  local -i count=0

  readarray -t timers < <(existing_timers)

  echo "Active $SCRIPT_NAME schedules:"
  echo '============================='
  if (( ${#timers[@]} == 0 )); then
    echo "No active $SCRIPT_NAME schedules found."
    return 0
  fi

  for timer in "${timers[@]}"; do
    count+=1
    # list-timers renders NEXT for both timer kinds in one stable layout (its
    # first four fields: weekday date time zone). LC_ALL=C keeps it stable.
    next=$(LC_ALL=C systemctl list-timers --all --no-pager --no-legend "$timer" 2>/dev/null \
      | awk -v t="$timer" '$0 ~ t && $2 ~ /^[0-9][0-9][0-9][0-9]-/ {print $1, $2, $3, $4; exit}' ||:)
    echo "$count. $timer - Scheduled: ${next:-unknown}"
  done
  echo '============================='
  echo "Total: $count scheduled reboot(s)"
}

# Delete a specific auto-reboot timer
delete_schedule() {
  local -- timer_name=$1 service_name

  # Accept full name, name without .timer, or bare timestamp ID
  if [[ ! $timer_name =~ ^$SCRIPT_NAME-[0-9]+\.timer$ ]]; then
    if [[ $timer_name =~ ^[0-9]+$ ]]; then
      timer_name="$SCRIPT_NAME-$timer_name.timer"
    elif [[ $timer_name =~ ^$SCRIPT_NAME-[0-9]+$ ]]; then
      timer_name="$timer_name.timer"
    else
      error "Invalid timer name format ${1@Q}. Use: $SCRIPT_NAME-TIMESTAMP or just TIMESTAMP"
      return 1
    fi
  fi

  existing_timers | grep -qxF -- "$timer_name" || { error "Timer $timer_name not found"; return 1; }

  service_name=${timer_name%.timer}.service
  info "Deleting $timer_name..."
  systemctl stop "$timer_name" || { error "Failed to stop $timer_name"; return 1; }
  # The service unit exists only while the timer fires; its absence is normal
  systemctl stop "$service_name" &>/dev/null ||:

  logger -t "$SCRIPT_NAME" "Deleted scheduled reboot timer: $timer_name by user $XUSER"
  info "Successfully deleted $timer_name"
}

# Delete all auto-reboot timers: preview in dry run, confirm on a terminal otherwise
delete_all_schedules() {
  local -a timers=()
  local -- timer
  local -i count

  readarray -t timers < <(existing_timers)
  count=${#timers[@]}
  if (( count == 0 )); then
    info "No $SCRIPT_NAME schedules found to delete."
    return 0
  fi

  if (( DRY_RUN )); then
    info "[DRY RUN] Would delete $count $SCRIPT_NAME schedule(s):" "${timers[@]}"
    info "[DRY RUN] Use ${SCRIPT_NAME@Q} with options '-N -D' to execute"
    return 0
  fi

  if [[ ! -t 0 ]]; then
    error 'Cannot prompt for confirmation in non-interactive mode'
    return 1
  fi
  info "Found $count $SCRIPT_NAME schedule(s):" "${timers[@]}"
  yn 'Delete all schedules?' || { info 'Deletion cancelled.'; return 0; }

  for timer in "${timers[@]}"; do
    delete_schedule "$timer" || return 1
  done

  logger -t "$SCRIPT_NAME" "Deleted all scheduled reboot timers ($count total) by user $XUSER"
  info "Deleted $count $SCRIPT_NAME schedule(s)."
}

# Install a root-owned copy to $PREFIX/bin (manpage and completion: make install)
install_auto_reboot() {
  local -- bindir="$PREFIX"/bin target
  target="$bindir/$SCRIPT_NAME"

  if [[ $SCRIPT_PATH == "$target" ]]; then
    info "$SCRIPT_NAME is already installed at ${target@Q}"
    return 0
  fi
  # A symlink left by older --install versions would make install(1) refuse the copy
  [[ ! -L $target ]] || rm -f -- "$target"
  install -d -- "$bindir" || { error "Cannot create ${bindir@Q}"; return 1; }
  install -m 755 -o root -g root -- "$SCRIPT_PATH" "$target" \
    || { error "Failed to install ${target@Q}"; return 1; }
  info "$SCRIPT_NAME installed at ${target@Q}" \
       "Run 'make install' from the source directory for the manpage and bash completion"
}

# Site defaults from CONF_FILE (BCS0111, deliberately a single system path:
# this script runs as root, so no user-writable location is ever searched).
# The file is sourced as bash, so it is refused unless root can trust it,
# and a file that fails to source is fatal rather than half-applied.
# Returns 1 only when there is no file.
read_conf() {
  local -- owner mode
  [[ -f $CONF_FILE ]] || return 1
  read -r owner mode < <(stat -c '%u %a' -- "$CONF_FILE") \
    || die 1 "Cannot stat ${CONF_FILE@Q}"
  # String compare: a non-numeric uid must fail, not coerce to 0
  [[ $owner == 0 ]] || die 13 "${CONF_FILE@Q} must be owned by root"
  (( (8#$mode & 8#022) == 0 )) || die 13 "${CONF_FILE@Q} must not be group- or world-writable"
  #shellcheck source=/dev/null
  source "$CONF_FILE" || die 19 "Failed to load ${CONF_FILE@Q}"
}

# Re-exec as root via sudo for sudo-group members; called only where root is
# needed (-N runs, delete, install). Nothing is forwarded: the root re-exec
# reads CONF_FILE itself, and sudo's env_reset carries no settings anyway.
# Args: the original command line, replayed verbatim
elevate_to_root() {
  ((EUID)) || return 0
  id -nG | grep -qw sudo || die 13 'Requires root or sudo group membership'
  exec sudo -- "$SCRIPT_PATH" "$@"
}

main() {
  local -a args=("$@")  # replayed verbatim by elevate_to_root

  # Config values are validated before anything else, including elevation
  read_conf ||:
  validate_time "$MACHINE_REBOOT_TIME" \
    || die 19 "MACHINE_REBOOT_TIME ${MACHINE_REBOOT_TIME@Q} in ${CONF_FILE@Q} is not a valid HH:MM time"
  validate_days "$MACHINE_UPTIME_MAXDAYS" \
    || die 19 "MACHINE_UPTIME_MAXDAYS ${MACHINE_UPTIME_MAXDAYS@Q} in ${CONF_FILE@Q} is not a positive integer"
  MACHINE_UPTIME_MAXDAYS=$((10#$MACHINE_UPTIME_MAXDAYS))
  [[ -z $MACHINE_ALLOWED_DAYS ]] || parse_allowed_days "$MACHINE_ALLOWED_DAYS" \
    || die 19 "MACHINE_ALLOWED_DAYS ${MACHINE_ALLOWED_DAYS@Q} in ${CONF_FILE@Q} is not a valid day list"

  # Parse command line arguments
  while (($#)); do
    case $1 in
      -h|--help)
        usage
        return 0
        ;;
      -n|--dry-run|--dryrun)
        DRY_RUN=1 ;;
      -N|--not-dry-run|--notdryrun)
        DRY_RUN=0 ;;
      -v|--verbose)
        VERBOSE=1 ;;
      -q|--quiet)
        VERBOSE=0 ;;
      -f|--force-reboot)
        FORCE_REBOOT=1 ;;
      -m|--max-uptime-days)
        noarg "$@"; shift
        validate_days "$1" || die 22 "--max-uptime-days ${1@Q} must be a positive integer"
        MACHINE_UPTIME_MAXDAYS=$((10#$1)) ;;
      -r|--reboot-time)
        noarg "$@"; shift
        validate_time "$1" || die 22 "--reboot-time ${1@Q} must be a valid time in HH:MM format (00:00-23:59)"
        MACHINE_REBOOT_TIME=$1 ;;
      -a|--allowed-days)
        noarg "$@"; shift
        parse_allowed_days "$1" || die 22 "--allowed-days ${1@Q} is not a valid day list" ;;
      # Standalone operations exit directly; parsing continues otherwise.
      # They run before the readonly freeze, so -N must precede -D to take effect.
      # Root is acquired only where needed; dry runs and --list stay unprivileged.
      -i|--install)
        elevate_to_root "${args[@]}"
        install_auto_reboot || exit $?
        exit 0 ;;
      -l|--list)
        list_schedules
        exit 0 ;;
      -d|--delete)
        noarg "$@"; shift
        elevate_to_root "${args[@]}"
        delete_schedule "$1" || exit $?
        exit 0 ;;
      #bcscheck disable=BCS0806 # -D is --delete-all here: public interface since 1.0, not --debug
      -D|--delete-all)
        (( DRY_RUN )) || elevate_to_root "${args[@]}"
        delete_all_schedules || exit $?
        exit 0 ;;
      -V|--version)
        echo "$SCRIPT_NAME $VERSION"
        exit 0 ;;
      --) shift; break ;;
      -[hnNfvqmraildDV]?*) # Expand bundled short opts: -Nf becomes -N -f
        set -- "${1:0:2}" "-${1:2}" "${@:2}"
        continue ;;
      -*) die 22 "Invalid option ${1@Q}" ;;
      *)  die 2 "Unexpected argument ${1@Q}" ;;
    esac
    shift
  done
  (($#)) && die 2 "Unexpected argument ${1@Q}" ||:

  # Freeze configuration after argument parsing
  readonly -- MACHINE_REBOOT_TIME MACHINE_UPTIME_MAXDAYS MACHINE_ALLOWED_DAYS
  readonly -- DRY_RUN FORCE_REBOOT VERBOSE
  readonly -a ALLOWED_DAYS

  (( DRY_RUN )) || elevate_to_root "${args[@]}"
  systemd_run_required
  check_reboot_conditions

  echo "Host: $HOSTNAME"
  if (( ! REBOOT_NEEDED )); then
    echo "Uptime: $(uptime -p)"
    echo "Reboot-required: $( [[ -f $REBOOT_REQUIRED_FILE ]] && echo present || echo absent)"
    echo 'Status: Reboot not required'
    return 0
  fi

  echo 'Status: Reboot required'
  [[ ! -f $REBOOT_REQUIRED_FILE ]] || echo '  - Reason: System updates require reboot'
  (( UPTIME_DAYS < MACHINE_UPTIME_MAXDAYS )) \
    || echo "  - Reason: Uptime ($UPTIME_DAYS days) has reached maximum ($MACHINE_UPTIME_MAXDAYS days)"
  (( ! FORCE_REBOOT )) || echo '  - Reason: Force reboot requested'

  local -i delay
  local -- target_time
  delay=$(calculate_reboot_delay "$MACHINE_REBOOT_TIME") || die 1 'Failed to calculate reboot delay'
  printf -v target_time '%(%F %T %Z)T' "$((EPOCHSECONDS + delay))"
  echo "Delay: $delay"
  echo "Scheduled: $target_time"

  schedule_reboot "$delay"
  (( ! DRY_RUN )) || info "[DRY RUN] Use ${SCRIPT_NAME@Q} with option '-N' to execute"
}

main "$@"
#fin
